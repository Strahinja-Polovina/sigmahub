# --- Secrets & local config — NEVER commit ---
/.mcp.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Scratch checkouts the agent harness creates inside the repo when a task runs
# in an isolated git worktree. They are full working copies of the repo (tens of
# MB, and one per concurrent task), so committing them would be committing the
# repository into itself.
.claude/worktrees/
.env
.env.local
.env*.local

# --- Dependencies & build output (web/ has its own too) ---
node_modules/
.next/
dist/
build/
# The agent's Go build-pipeline package is source, not a build-output dir.
!agent/internal/build/
.turbo/
out/

# --- Local data (SQLite / PGlite, etc.) ---
.data/
*.db
*.sqlite
*.sqlite3

# --- OS / logs / editor ---
.DS_Store
Thumbs.db
*.log
.codex/
.idea/

# Go build artifacts
cp/bin/
agent/bin/
