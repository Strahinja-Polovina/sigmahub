# Copy to .env next to docker-compose.yml and fill in.
CP_DB_PASSWORD=change-me
CP_PROVISION_TOKEN=change-me
CP_GITHUB_WEBHOOK_SECRET=
# CP's own public base URL (what GitHub can reach). With the webhook secret
# set, connecting a repo auto-registers its push-to-deploy webhook.
#
# Leave it empty and it takes SIGMAHUB_CP_PUBLIC_URL below — the same address
# under the other name. Set it only if GitHub reaches this control plane at a
# different name than a BYO host does.
CP_PUBLIC_URL=
CP_ACME_EMAIL=ops@example.com
# Dashboard session signing key: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL the dashboard is served on (cookies/redirects) — and the site
# address the bundled TLS terminator serves it on, so this is a name that
# resolves to this host, not localhost, in any real deployment.
WEB_PUBLIC_URL=https://your-dashboard-domain
# Require a verified email address before sign-in is allowed. Turn this on once
# a real SMTP transport is wired into the dashboard — no transport is bundled,
# so today the verification link only reaches the web container's log and
# enabling this would strand sign-ups. Accepts the same spellings as the CP's
# boolean settings (true/false/1/0/True/…); anything else fails the dashboard's
# boot rather than quietly leaving sign-in open to unverified addresses.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Public URL a BYO host uses to reach the control plane (must be reachable from
# outside this compose network — the in-cluster http://cp:8080 is not). Rendered
# into the agent install command shown by the connect-server wizard.
# MUST be https: the install command pipes /install.sh into `sudo bash`, and that
# script is the one artifact cosign cannot cover — it is what runs cosign.
#
# The stack now ships the terminator that makes this true: the `proxy` service
# (Caddy) in docker-compose.yml serves this address and WEB_PUBLIC_URL on 80/443
# and gets certificates over ACME on its own, while cp and web bind to loopback
# only. Name an https URL here and it answers. Name an http one and the control
# plane refuses to serve /install.sh at all, rather than handing a host a script
# it cannot vouch for — see cp/internal/api/installer.go.
SIGMAHUB_CP_PUBLIC_URL=https://your-host-or-domain
# Released agent tag the control plane installs (e.g. v0.3.0). Must be an
# existing release — there is no asset published under "latest".
#
# One value, one consumer, and ONE NAME (SIGMA-269): this key is spelled
# CP_AGENT_VERSION because that is the name the refusal prints — "Set
# CP_AGENT_VERSION to a released tag such as v0.3.0" — and the dashboard shows
# that sentence verbatim. It used to be SIGMAHUB_AGENT_VERSION here, so an
# operator following the instruction to the letter changed nothing. The
# dashboard holds no copy of it: it asks the control plane.
#
# Leave it empty for a released image and the control plane installs the release
# it was itself built from; a source build has no release tag to fall back on,
# so onboarding refuses until this is set rather than guessing.
CP_AGENT_VERSION=v0.3.0
# Where those assets come from. The control plane serves install.sh and proxies
# the release assets itself, so the host being onboarded only ever talks to the
# control plane — which is what makes a PRIVATE release repository onboardable.
#
# CP_RELEASE_TOKEN is the one to set: a GitHub token with contents:read on the
# release repository. Leave it empty for a public release — that is correct, not
# degraded.
#
# CP_RELEASE_REPO stays empty. It exists so the slug is not hard-coded in the
# proxy, but it may only name the repository install.sh cosign-verifies against;
# a fork would have its artifacts refused on the host, after the one-time
# bootstrap key was already spent, so boot fails instead. Serving a fork means
# changing SIGMAHUB_REPO in agent/packaging/install.sh and shipping your own
# agent build.
CP_RELEASE_REPO=
CP_RELEASE_TOKEN=
# Key custody: file (dev) or vault (production; requires a transit key).
CP_KMS_BACKEND=file
CP_VAULT_ADDR=
CP_VAULT_TOKEN=
CP_VAULT_TRANSIT_KEY=sigmahub-cp
# Vault Enterprise namespace; empty is the root namespace, which is what a
# single-namespace Vault wants. Set it and every transit call is scoped there —
# unset on a namespaced Vault, the calls go to root instead, and the symptom is
# secrets that will not unwrap rather than an error naming a namespace.
CP_VAULT_NAMESPACE=
# Require the X-Sigmahub-Actor header on org-scoped service tokens (SIGMA-82).
# Empty/false is the default: the header only ever NARROWS a token's role and is
# self-signed by the token holder, so it is convenience rather than a trust
# boundary. Set true if you provision per-role tokens and want a user-facing
# token used with no actor to fail closed.
CP_REQUIRE_ACTOR=
# GitHub App (optional; replaces pasted PATs for private repos). Register the
# app per cp/docs/github-app.md, then set the id + slug and drop the
# downloaded PEM next to this file as github-app.pem (imported into KMS
# custody on first boot — the file can be deleted afterwards).
CP_GITHUB_APP_ID=
CP_GITHUB_APP_SLUG=
# Engine allowlists (P1-10 databases, P2-2 object storage). EMPTY = every engine
# the control plane's catalog defines, and that is the value to leave here
# (SIGMA-268): these keys used to restate the engine names, which froze each
# install at the list that existed when the line was written — a newly shipped
# engine then appeared in the wizard and was refused at create time.
#
# Set one only to CUT the list: CP_DB_ENGINES=postgres for a Postgres-only
# build, CP_S3_ENGINES=minio for a MinIO-only one. An engine name the catalog
# does not know fails boot, naming the ones it does.
CP_DB_ENGINES=
CP_S3_ENGINES=
# Telemetry (optional): point at vminsert/vmselect and Loki to enable P1-13.
# Turnkey option: COMPOSE_PROFILES=telemetry starts bundled Loki + a minimal
# VictoriaMetrics cluster in this compose project; then use the in-cluster
# URLs below.
# COMPOSE_PROFILES=telemetry
# CP_VM_WRITE_URL=http://vminsert:8480
# CP_VM_READ_URL=http://vmselect:8481
# CP_LOKI_URL=http://loki:3100
CP_VM_WRITE_URL=
CP_VM_READ_URL=
CP_LOKI_URL=
# How long host samples live in the control-plane database (Go duration; 24h by
# default). With no telemetry pipeline configured this is ALSO the furthest back
# the server metrics endpoint will serve — it clamps a longer request and says
# so, rather than drawing a week-wide chart out of one day of samples.
# CP_METRICS_RETENTION=24h
# How long the bundled telemetry sinks keep a customer's data (SIGMA-298).
# These are read by docker-compose.yml, not by the control plane.
#
# CP_LOKI_RETENTION is the DEFAULT log retention every tenant inherits; the
# lines are raw container stdout/stderr, so they routinely contain the
# customer's end users' email addresses and identifiers. Per-tenant exceptions
# go in loki/runtime-config.yaml. Erasing one tenant on request is a different
# operation — DELETE /v1/orgs/{orgId} on the control plane.
# CP_LOKI_RETENTION=720h
# CP_VM_RETENTION is vmstorage's -retentionPeriod (VictoriaMetrics duration:
# 90d, 12m, …). Metrics carry no message bodies, so they are kept longer.
# CP_VM_RETENTION=90d
# Billing (P2-4, Paddle; optional). Empty API key = billing off (usage preview
# only, no charges). Empty webhook secret = the webhook receiver 503s.
CP_PADDLE_API_KEY=
CP_PADDLE_WEBHOOK_SECRET=
CP_PADDLE_ENV=sandbox
CP_PADDLE_PRICE_ID=
